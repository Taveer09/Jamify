{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/index.html"
    },
    {
      "source": "/callback",
      "destination": "/index.html"
    },
    {
      "source": "/diagnostics",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "usejamify.vercel.app"
        }
      ],
      "destination": "https://jamify-lyart.vercel.app/:path*",
      "permanent": false
    }
  ]
}
